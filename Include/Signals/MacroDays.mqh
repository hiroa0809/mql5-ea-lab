//+------------------------------------------------------------------+
//| MacroDays.mqh                                                    |
//| マクロ指標が反応した日（R2）の一覧                               |
//|                                                                  |
//| 別プロジェクト（OLS-MeanReversion_MT5）が「行き過ぎからの回帰」  |
//| を狙う売買で**エントリーを止める日**として使っている一覧を、そのまま|
//| 借りている。向きは逆で、こちらは**トレンドが出ている日**とみなして |
//| 取引の対象日に使う（マクロが荒れている＝回帰が効かない＝順張り側に |
//| 都合がよい、という仮説。2026-08-21 ユーザー判断）。               |
//|                                                                  |
//| ■ R2 の中身（4つの OR。どれか1つでも当てはまれば「反応した日」）  |
//|   1. 恐怖指数(VIX)が 25 超                                        |
//|   2. 恐怖指数が過去252日の平均から見て +1.5σ 超                    |
//|   3. 原油(WTI)の66日リターンが −1.5σ 未満                          |
//|   4. 信用代理(HYG/IEF)の66日リターンが −1.5σ 未満                  |
//|   ※ ドル円そのものの情報は入っていない。「世界が荒れている」と    |
//|      「ドル円にトレンドが出る」の関係は間接的であり、そこを検証する|
//|                                                                  |
//| ■ 先読みは無い                                                    |
//|   元データは shift_days=1（前営業日の終値で判定）で作られている。  |
//|   当日の終値で判定する設定も存在するが、そちらは使っていない。     |
//|                                                                  |
//| ■ 日付の扱いについての注意                                        |
//|   元の一覧は **UTC のカレンダー日**。本ファイルの判定は足の時刻を  |
//|   そのまま使うため、**サーバー時刻（UTC+2〜3）の日付**で当たる。   |
//|   区間の境目が数時間ずれるが、区間の長さは中央値で3〜4日あり、     |
//|   判定自体が前営業日ぶん遅れているため、影響は境目付近に限られる。 |
//|                                                                  |
//| 出典: docs/suppress_days_r2_report.txt（73区間・実日数876日）      |
//|       生成元 D:\Antigravity\OLS-MeanReversion_MT5\backend\        |
//|              backtest\macro_filter.py の _rule_r2()                |
//+------------------------------------------------------------------+
#ifndef MACRO_DAYS_MQH
#define MACRO_DAYS_MQH

#define MACRO_R2_COUNT 73

//--- 区間の開始日・終了日（yyyymmdd・両端を含む・日付順）
const int MacroR2From[MACRO_R2_COUNT] =
{
   20181011, 20181024, 20190129, 20190604, 20190806, 20190813,
   20190815, 20200203, 20200225, 20200609, 20200724, 20200729,
   20200901, 20201013, 20201110, 20201113, 20201222, 20210105,
   20210128, 20210226, 20210304, 20210309, 20210513, 20210610,
   20210621, 20210624, 20210630, 20210921, 20211129, 20211201,
   20211221, 20220121, 20220214, 20220218, 20220425, 20220607,
   20220610, 20220713, 20220722, 20220804, 20220810, 20220817,
   20220825, 20221109, 20230314, 20230316, 20230319, 20231207,
   20231213, 20231229, 20240109, 20240416, 20240422, 20240617,
   20240712, 20240717, 20240725, 20241004, 20241008, 20241016,
   20241027, 20241031, 20241219, 20250228, 20250304, 20250402,
   20251017, 20251121, 20260308, 20260313, 20260319, 20260322,
   20260408
};

const int MacroR2To[MACRO_R2_COUNT] =
{
   20181016, 20190127, 20190130, 20190604, 20190811, 20190813,
   20190815, 20200203, 20200607, 20200720, 20200727, 20200729,
   20201011, 20201108, 20201110, 20201115, 20201222, 20210107,
   20210203, 20210301, 20210307, 20210309, 20210513, 20210610,
   20210622, 20210627, 20210825, 20210921, 20211129, 20211207,
   20211221, 20220201, 20220216, 20220319, 20220602, 20220607,
   20220713, 20220720, 20220801, 20220808, 20220814, 20220823,
   20221106, 20221110, 20230314, 20230316, 20230321, 20231211,
   20231220, 20240107, 20240109, 20240417, 20240422, 20240627,
   20240715, 20240721, 20240918, 20241006, 20241014, 20241016,
   20241028, 20241106, 20241222, 20250302, 20250315, 20250512,
   20251019, 20251123, 20260310, 20260316, 20260319, 20260401,
   20260408
};

//--- **元データが覆っている範囲**。最初と最後の「反応した日」ではない。
//--- 出典レポートの学習期間は 2018-09-28 開始、検証期間は 2026-04-17 終了。
//--- 反応日は 20181011〜20260408 だが、その手前と後ろにも「反応しなかったと
//--- 判定された日」があり、そこは正しく「反応なし」と答えられる。
//---
//--- **この範囲を外れた日は判定できない。** MacroR2IsOn() は false を返すが、
//--- それは「反応しなかった」ではなく「分からない」。そのまま使うと
//--- 「反応した日だけ」は全部弾き、「反応しなかった日だけ」は**全部通す**。
//--- 後者は絞り込みが無効になったまま黙って動くので、呼ぶ側は
//--- MacroR2Covered() で先に確かめること。
#define MACRO_R2_COVER_FROM 20180928
#define MACRO_R2_COVER_TO   20260417

//--- 一覧に載っている最初と最後の反応日（表示用）
#define MACRO_R2_FIRST 20181011
#define MACRO_R2_LAST  20260408

//+------------------------------------------------------------------+
//| 時刻を yyyymmdd の整数にする                                     |
//+------------------------------------------------------------------+
int MacroYmd(const datetime t)
{
   MqlDateTime d;
   TimeToStruct(t, d);
   return d.year * 10000 + d.mon * 100 + d.day;
}

//+------------------------------------------------------------------+
//| その日について判定できるか（元データが覆っているか）             |
//|                                                                  |
//| **MacroR2IsOn() を呼ぶ前に必ず確かめる。** false のときの         |
//| MacroR2IsOn() は「反応しなかった」ではなく「分からない」。        |
//+------------------------------------------------------------------+
bool MacroR2Covered(const int ymd)
{
   return (ymd >= MACRO_R2_COVER_FROM && ymd <= MACRO_R2_COVER_TO);
}

//+------------------------------------------------------------------+
//| その日がマクロ指標の反応した日か                                 |
//|                                                                  |
//| 区間は日付順に並んでいるので、開始日が調べたい日を追い越した      |
//| 時点で打ち切る。                                                  |
//+------------------------------------------------------------------+
bool MacroR2IsOn(const int ymd)
{
   for(int i = 0; i < MACRO_R2_COUNT; i++)
   {
      if(MacroR2From[i] > ymd) return false;
      if(ymd <= MacroR2To[i])  return true;
   }
   return false;
}

#endif // MACRO_DAYS_MQH
