//+------------------------------------------------------------------+
//| Pivot.mqh                                                        |
//| デイリーピボットの計算                                           |
//|                                                                  |
//| 場立ち時代から使われている古典的な式（フロアトレーダー・ピボット）|
//| で、**前日の高値・安値・終値だけ**から当日の7本の水準を出す。    |
//| 移動平均のような平滑化は一切しない。                             |
//|                                                                  |
//| **当日の水準は前日の確定した足から作る。** これは本プロジェクトの |
//| 「確定した上位足の値を次の区間へ並べる」規則（docs/              |
//| indicator_spec.md §2.4）とそのまま一致する。前日は閉じているので |
//| 当日の水準は日中いっさい動かない。                                |
//|                                                                  |
//| 注意: ピボットは**中心線からの距離を測らない**。前日の値幅から作る|
//| 固定の横線であり、値動きが平均から離れすぎたかどうかは分からない。|
//+------------------------------------------------------------------+
#ifndef PIVOT_MQH
#define PIVOT_MQH

//+------------------------------------------------------------------+
//| 1日ぶんの水準                                                    |
//+------------------------------------------------------------------+
struct PivotLevels
{
   double p;              // ピボット（中心）
   double r1, r2, r3;     // 上の抵抗
   double s1, s2, s3;     // 下の支持
};

//+------------------------------------------------------------------+
//| 前日の高値・安値・終値から当日の水準を求める                     |
//|                                                                  |
//| r3 / s3 は「r2 に値幅を足す」形ではなく、高値・安値を起点にする  |
//| 古典的な式を使う。両者は別の値になるので混ぜないこと。           |
//+------------------------------------------------------------------+
bool PV_Calc(const double high, const double low, const double close, PivotLevels &out)
{
   if(high < low) return false;

   out.p  = (high + low + close) / 3.0;

   out.r1 = 2.0 * out.p - low;
   out.s1 = 2.0 * out.p - high;

   out.r2 = out.p + (high - low);
   out.s2 = out.p - (high - low);

   out.r3 = high + 2.0 * (out.p - low);
   out.s3 = low  - 2.0 * (high - out.p);

   return true;
}

#endif
