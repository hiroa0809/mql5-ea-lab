//+------------------------------------------------------------------+
//| HigherTf.mqh                                                     |
//| 上位足の値を下位足のチャートへ並べるときの共通部分               |
//|                                                                  |
//| 「どの上位足を選べるか」と「下位足の1本に対してどの上位足の値を  |
//| 使うか」を、これを読む全員で1つにするためのファイル。2箇所に書く |
//| と、片方だけ直したときに2本のインジケーターが別の位置に線を引き、 |
//| どちらが正しいのか分からなくなる。                               |
//|                                                                  |
//| 置き方の定義は docs/indicator_spec.md §2.4。                     |
//+------------------------------------------------------------------+
#ifndef HIGHERTF_MQH
#define HIGHERTF_MQH

//+------------------------------------------------------------------+
//| 重ねる上位足                                                     |
//|                                                                  |
//| 全時間足から選ばせない。下位足より短い足を選ぶと意味がなく、      |
//| 選択肢に混ぜておくと事故る。                                      |
//+------------------------------------------------------------------+
enum ENUM_HIGHER_TF
{
   HTF_H1 = PERIOD_H1,   // 1時間足
   HTF_H4 = PERIOD_H4,   // 4時間足
   HTF_D1 = PERIOD_D1    // 日足
};

//+------------------------------------------------------------------+
//| 上位足の日本語名                                                 |
//+------------------------------------------------------------------+
string HigherTfLabel(const ENUM_TIMEFRAMES tf)
{
   if(tf == PERIOD_H1) return "1時間足";
   if(tf == PERIOD_H4) return "4時間足";
   if(tf == PERIOD_D1) return "日足";
   return EnumToString(tf);
}

//+------------------------------------------------------------------+
//| 走査の開始点を求める                                             |
//|                                                                  |
//| 下位足の全本数について毎回 iBarShift を呼ぶと重いので、最初の1本 |
//| だけここで求め、あとは HTF_ConfirmedShift で1本ずつ遡らせる。    |
//| htfSize は上位足の値をいくつ用意したか。                          |
//+------------------------------------------------------------------+
bool HTF_StartCursor(const string symbol, const ENUM_TIMEFRAMES tf, const datetime barTime,
                     const int htfSize, int &cursor)
{
   if(htfSize < 1) return false;

   const int h = iBarShift(symbol, tf, barTime, false);
   if(h < 0) return false;

   cursor = (h >= htfSize) ? htfSize - 1 : h;
   return true;
}

//+------------------------------------------------------------------+
//| 下位足の1本に対して、使うべき上位足の位置を返す                  |
//|                                                                  |
//| **返すのは、その足が属する上位足ではなく、その1本前**。属する足は|
//| まだ動いている最中で終値が決まっておらず、そこから作った値を描く |
//| と、これから起きることを先に見てしまう。1本前なら確定済みなので、 |
//| 画面のどの時点を見てもその時点で知り得た値しか映らない。          |
//|                                                                  |
//| cursor は前回の位置。下位足を古い方から新しい方へ走査する前提で、|
//| 単調に減る。呼ぶ側は同じ cursor を渡し続けること。               |
//+------------------------------------------------------------------+
int HTF_ConfirmedShift(const datetime barTime, const datetime &htfTime[], int &cursor)
{
   while(cursor > 0 && htfTime[cursor - 1] <= barTime)
      cursor--;

   return cursor + 1;
}

#endif
